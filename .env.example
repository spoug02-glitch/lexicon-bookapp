# ── 데이터베이스 ──────────────────────────────────────────────
# 로컬 SQLite 파일 경로. 그대로 두면 됨.
DATABASE_URL="file:./prisma/dev.db"

# ── 도서관정보나루 (data4library.kr) ─────────────────────────
# 발급: https://www.data4library.kr/openApi/apply (회원가입 후 API키 신청, 승인까지 시간이 걸릴 수 있음)
LIBRARY_API_KEY=""

# ── 알라딘 Open API (aladin.co.kr) ───────────────────────────
# 발급: https://blog.aladin.co.kr/openapi/방문 → TTBKey 신청
# 개인 계정 기준 일 5,000회 호출 제한
ALADIN_TTB_KEY=""

# ── NextAuth (Auth.js) ────────────────────────────────────────
# AUTH_SECRET은 세션 암호화용 임의 문자열. 아래 명령으로 생성:
#   npx auth secret
AUTH_SECRET=""

# Google OAuth 클라이언트 (https://console.cloud.google.com/apis/credentials)
# - 애플리케이션 유형: 웹 애플리케이션
# - 승인된 리디렉션 URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Notion 연동 (리뷰 내보내기/불러오기) ──────────────────────
# 1) https://www.notion.so/my-integrations 에서 새 Integration 생성 → Internal Integration Secret 복사
# 2) Notion에 새 페이지 생성 후 우측 상단 "..." → 연결 추가 → 방금 만든 Integration 연결
# 3) 그 페이지 ID로 아래 명령 실행하면 리뷰 동기화용 데이터베이스가 자동 생성됨:
#      npm run notion:setup -- <페이지ID>
#    (페이지ID는 Notion 페이지 URL의 "?" 앞부분, 32자리 문자열)
# 4) 스크립트가 출력하는 데이터소스 ID를 NOTION_DATABASE_ID에 붙여넣기
NOTION_API_KEY=""
NOTION_DATABASE_ID=""
